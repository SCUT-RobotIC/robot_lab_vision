<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="ros_version" value="$(env ROS_VERSION)" />

    <xacro:macro name="joint_transmission" params="joint_name">
        <transmission name="${joint_name}_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${joint_name}">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
            <actuator name="${joint_name}_motor">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>

    <xacro:if value="${int(ros_version) == 1}">
        <gazebo>
            <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
                <robotNamespace>/rc_gazebo</robotNamespace>
                <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
            </plugin>
        </gazebo>
    </xacro:if>

    <xacro:joint_transmission joint_name="FL_hip_joint"/>
    <xacro:joint_transmission joint_name="FL_thigh_joint"/>
    <xacro:joint_transmission joint_name="FL_calf_joint"/>
    <xacro:joint_transmission joint_name="FR_hip_joint"/>
    <xacro:joint_transmission joint_name="FR_thigh_joint"/>
    <xacro:joint_transmission joint_name="FR_calf_joint"/>
    <xacro:joint_transmission joint_name="RL_hip_joint"/>
    <xacro:joint_transmission joint_name="RL_thigh_joint"/>
    <xacro:joint_transmission joint_name="RL_calf_joint"/>
    <xacro:joint_transmission joint_name="RR_hip_joint"/>
    <xacro:joint_transmission joint_name="RR_thigh_joint"/>
    <xacro:joint_transmission joint_name="RR_calf_joint"/>
</robot>
